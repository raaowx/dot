# shellcheck shell=bash
# === === === SHELL PROFILE === === === #
# VARIABLES
SHELL_VARIABLES="$HOME/.shell_variables"
if [ -r "$SHELL_VARIABLES" ]; then
	# shellcheck source=./variables.shell
	. "$SHELL_VARIABLES"
fi
# MESSAGES
# Sourced before any output is produced, so the startup can use the emitters
SHELL_MESSAGES="$HOME/.shell_messages"
if [ -r "$SHELL_MESSAGES" ]; then
	# shellcheck source=./messages.shell
	. "$SHELL_MESSAGES"
fi
# CONFIGURATION
case "${INTERPRETER}" in
"bash") ;;
"zsh")
	setopt AUTO_CD       # Perform 'cd' if argument in stdin is a directory instead of a command
	setopt NO_CASE_GLOB  # Autocompletion will be case insensitive
	setopt GLOB_COMPLETE # Show a menu of possible matches when completing with wildcards (TAB to cycle through options)
	setopt PROMPT_SUBST  # Enable prompt function execution capabilities
	# Shellcheck doesn't support linting over ZSH instructions
	# https://github.com/koalaman/shellcheck/issues/809
	# shellcheck disable=SC2034
	ZLE_SPACE_SUFFIX_CHARS=$'|&'
	;;
esac
# PROMPT
# Colours follow the message convention: structure in blue, values in cyan,
# paths in magenta, status in green/red. Zsh keeps the numeric %F{n} codes
# instead of the palette variables: raw escapes would need %{...%} wrapping
# for zsh to compute the prompt width, and getting that wrong corrupts the
# prompt. Correspondence: 9↔RB, 10↔GB, 12↔AB, 13↔MB, 14↔CB, 15↔WB.
case "${INTERPRETER}" in
"bash")
	# $? must be captured first, before anything else overwrites it
	export PROMPT_COMMAND='__exit=$?; history -a; history -n'
	__status() { [ "${__exit:-0}" -eq 0 ] && printf '\001%b\002√' "$GB" || printf '\001%b\002%s' "$RB" "$__exit"; }
	export PS1='\[$AB\][\D{%a %d.%m.%Y} - \t]\[$AB\] ~ \[$CB\]\!\[$AB\] ~ \[$CB\]#\#\n\[$AB\]··> \[$CB\]\h\[$AB\] { \[$CB\]\j\[$AB\] } <·· [\[$CB\]\u\[$AB\]] \[$MB\]\W\[$AB\] \[$CB\]$(gitbranch)\[$AB\]$(__status)\[$RESET\]\$ '
	export PS2='\[$AB\]··>\[$RESET\] '
	;;
"zsh")
	export PS1='%F{12}[%D{%a %d.%m.%Y - %H:%M:%S}]$NEWLINE%F{12}··> %F{14}%m%F{12} { %F{14}%j%F{12} } <·· [%F{14}%n%F{12}] %F{13}%1~%F{12} %F{14}$(gitbranch)%f%# '
	export RPS1='%F{14}%!%F{12} ~ %(?.%F{10}√%f.%F{9}%?%f)'
	export PS2='%F{12}··>%f '
	export RPS2='%F{12}<··%f'
	;;
esac
# HISTORY
export HISTSIZE=333    # Number of commands in history
export SAVEHIST=999999 # Number of lines in file
case "${INTERPRETER}" in
"bash")
	export HISTCONTROL='ignoreboth' # Ignores repeated command & commands starting with a space
	;;
"zsh")
	setopt INC_APPEND_HISTORY # Write to the history file immediately, not when the shell exits
	setopt HIST_IGNORE_SPACE  # Don't record an entry starting with a space
	setopt HIST_IGNORE_DUPS   # Don't record an entry that was just recorded again
	setopt HIST_SAVE_NO_DUPS  # Don't write duplicate entries in the history file
	;;
esac

# === WELCOME === #
echo -e "\n$CB Hi $USER! Welcome to $INTERPRETER $INTERPRETER_VERSION$RESET\n"

# === LOAD FILES === #
shell-info "Loading completion:"
case "${INTERPRETER}" in
"bash")
	# LOAD BASH COMPLETION
	BASH_COMPLETION="$COMPLETIONS_ROOT/completion.bash"
	if [ -r "$BASH_COMPLETION" ]; then
		echo -e "$WB   ·$CB bash$RESET"
		# This file may change location depending on OS
		# shellcheck disable=SC1090
		. "$BASH_COMPLETION"
	fi
	# LOAD GIT COMPLETION
	GIT_COMPLETION="$COMPLETIONS_ROOT/git-completion.bash"
	if [ -r "$GIT_COMPLETION" ]; then
		echo -e "$WB   ·$CB git$RESET"
		# This file may change location depending on OS
		# shellcheck disable=SC1090
		. "$GIT_COMPLETION"
	fi
	# LOAD DOCKER COMPLETION
	DOCKER_COMPLETION="$COMPLETIONS_ROOT/docker-completion.bash"
	if [ -r "$DOCKER_COMPLETION" ]; then
		echo -e "$WB   ·$CB docker$RESET"
		# This file may change location depending on OS
		# shellcheck disable=SC1090
		. "$DOCKER_COMPLETION"
	fi
	# LOAD DOCKER COMPOSE COMPLETION
	DOCKER_COMPOSE_COMPLETION="$COMPLETIONS_ROOT/docker-compose-completion.bash"
	if [ -r "$DOCKER_COMPOSE_COMPLETION" ]; then
		echo -e "$WB   ·$CB docker-compose$RESET"
		# This file may change location depending on OS
		# shellcheck disable=SC1090
		. "$DOCKER_COMPOSE_COMPLETION"
	fi
	# LOAD BREW COMPLETION
	if type brew &>/dev/null; then
		HOMEBREW_PREFIX="$BREW_HOME"
		if [ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]; then
			echo -e "$WB   ·$CB brew$RESET"
			# This file may change location depending on OS
			# shellcheck disable=SC1091
			. "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
		else
			# The message goes outside the loop: it would otherwise be
			# printed once per completion file
			echo -e "$WB   ·$CB brew$RESET"
			for COMPLETION in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*; do
				if [ -r "${COMPLETION}" ]; then
					# This file may change location depending on OS
					# shellcheck disable=SC1090
					. "${COMPLETION}"
				fi
			done
		fi
	fi
	;;
"zsh")
	# LOAD COMPLETION STYLES
	echo -e "$WB   ·$CB completion styles$RESET"
	zstyle ':completion:*' completer _expand _complete _ignored _approximate
	# Shellcheck doesn't support linting over ZSH instructions
	# https://github.com/koalaman/shellcheck/issues/809
	# shellcheck disable=SC2086,SC2296
	zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
	zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]} l:|=* r:|=*'
	zstyle ':completion:*' list-suffixes
	zstyle ':completion:*' expand prefix suffix
	zstyle ':completion:*' menu select=1
	# Shellcheck doesn't support linting over ZSH instructions
	# https://github.com/koalaman/shellcheck/issues/809
	# shellcheck disable=SC1083
	zstyle ':completion:*' select-prompt %SCompletion Scrolling { %l }:%s
	# LOAD GIT COMPLETION
	GIT_COMPLETION_ZSH="$COMPLETIONS_ROOT/git-completion.zsh"
	GIT_COMPLETION_BASH="$COMPLETIONS_ROOT/git-completion.bash"
	if [ -r "$GIT_COMPLETION_ZSH" ] && [ -r "$GIT_COMPLETION_BASH" ]; then
		echo -e "$WB   ·$CB git$RESET"
		zstyle ':completion:*:*:git:*' script "$GIT_COMPLETION_BASH"
		# Shellcheck doesn't support linting over ZSH instructions
		# https://github.com/koalaman/shellcheck/issues/809
		# shellcheck disable=SC2206,SC2128
		fpath=("$GIT_COMPLETION_ZSH" $fpath)
	fi
	# LOAD DOCKER COMPLETION
	DOCKER_COMPLETION="$COMPLETIONS_ROOT/docker-completion.zsh"
	if [ -r "$DOCKER_COMPLETION" ]; then
		echo -e "$WB   ·$CB docker$RESET"
		# Shellcheck doesn't support linting over ZSH instructions
		# https://github.com/koalaman/shellcheck/issues/809
		# shellcheck disable=SC2128,SC2206
		fpath=("$DOCKER_COMPLETION" $fpath)
	fi
	# LOAD DOCKER COMPOSE COMPLETION
	DOCKER_COMPOSE_COMPLETION="$COMPLETIONS_ROOT/docker-compose-completion.zsh"
	if [ -r "$DOCKER_COMPOSE_COMPLETION" ]; then
		echo -e "$WB   ·$CB docker-compose$RESET"
		# Shellcheck doesn't support linting over ZSH instructions
		# https://github.com/koalaman/shellcheck/issues/809
		# shellcheck disable=SC2128,SC2206
		fpath=("$DOCKER_COMPOSE_COMPLETION" $fpath)
	fi
	# LOAD BREW COMPLETION
	if type brew &>/dev/null; then
		echo -e "$WB   ·$CB brew$RESET"
		FPATH="$BREW_HOME/share/zsh/site-functions:${FPATH}"
	fi
	# LOAD ZSH COMPLETION
	echo -e "$WB   ·$CB zsh$RESET"
	autoload -Uz compinit
	# Shellcheck doesn't support linting over ZSH instructions
	# https://github.com/koalaman/shellcheck/issues/809
	if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+12) ]]; then
		compinit
	else
		compinit -C
		# Shellcheck doesn't support linting over ZSH instructions
		# https://github.com/koalaman/shellcheck/issues/809
		# shellcheck disable=SC2168
		local _insecure
		_insecure=$(compaudit 2>/dev/null)
		if [[ -n "$_insecure" ]]; then
			shell-warn "compinit found insecure files or directories:"
			echo "$_insecure" >&2
		fi
	fi
	autoload bashcompinit && bashcompinit
	;;
esac

# LOAD NVM COMPLETION (lazy)
# Only the path is resolved here; the completion is sourced by the lazy stub
# below, which is where 'nvm (lazy)' is reported
NVM_COMPLETION="$COMPLETIONS_ROOT/nvm-completion.shell"

echo
shell-info "Loading scripts:"

# LOAD FILES
SHELL_ALIASES="$HOME/.shell_aliases"
if [ -r "$SHELL_ALIASES" ]; then
	echo -e "$WB   ·$CB aliases$RESET"
	# shellcheck source=./aliases.shell
	. "$SHELL_ALIASES"
fi

SHELL_FUNCTIONS="$HOME/.shell_functions"
if [ -r "$SHELL_FUNCTIONS" ]; then
	echo -e "$WB   ·$CB functions$RESET"
	# shellcheck source=./functions.shell
	. "$SHELL_FUNCTIONS"
fi

# LOAD NVM (lazy)
if [ -r "$NVM_ROOT/nvm.sh" ]; then
	echo -e "$WB   ·$CB nvm (lazy)$RESET"
	nvm() {
		unset -f nvm node npm npx
		# shellcheck disable=SC1091
		. "$NVM_ROOT/nvm.sh"
		# Path resolved at runtime from COMPLETIONS_ROOT
		# shellcheck disable=SC1090
		[ -r "$NVM_COMPLETION" ] && . "$NVM_COMPLETION"
		nvm "$@"
	}
	node() { nvm use default >/dev/null 2>&1; node "$@"; }
	npm()  { nvm use default >/dev/null 2>&1; npm  "$@"; }
	npx()  { nvm use default >/dev/null 2>&1; npx  "$@"; }
fi

SHELL_BOX="$HOME/.shell_box"
if [ -r "$SHELL_BOX" ]; then
	echo
	shell-info "Loading box:"
	# This file may not exists
	# shellcheck disable=SC1090
	. "$SHELL_BOX"
fi

SHELL_JOB="$HOME/.shell_job"
if [ -r "$SHELL_JOB" ]; then
	echo
	shell-info "Loading job:"
	# This file may not exists
	# shellcheck disable=SC1090
	. "$SHELL_JOB"
fi

echo -e "\n$CB All tools were loaded, enjoy your shell$RESET\n"

# LOAD SHELL INIT
SHELL_INIT="$HOME/.shell_init"
if [ -r "$SHELL_INIT" ]; then
	# shellcheck source=./init.shell
	. "$SHELL_INIT"
fi
