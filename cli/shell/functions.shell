# shellcheck shell=bash
# === === === SHELL FUNCTIONS === === === #
# A
add-space-to-dock() {
  if ! defaults write com.apple.dock persistent-apps -array-add '{"tile-type"="spacer-tile";}'; then
    shell-error "Could not write to Dock preferences"
    return 1
  fi
  killall Dock
  sleep 3
  open -a Dock
}
# B
# C
cleanup-history() {
  case "${INTERPRETER}" in
  "bash")
    echo -n > "$HOME/.bash_history"
    history -c
    ;;
  "zsh")
    echo -n > "$HOME/.zsh_history"
    ;;
  esac
}
cleanup-app-associated-files() {
  if [ $# -eq 0 ]; then
    shell-error "Usage: cleanup-app-associated-files <app_name>"
    return 1
  fi

  local app_name="$*"
  local fd_bin
  fd_bin="$(command -v fd)" || {
    shell-error "fd not found"
    return 1
  }

  shell-info "Elevated permissions are required to search and delete protected directories"
  sudo -v || { shell-error "Authentication failed"; return 1; }

  # Directories excluded from the search — add or remove entries as needed
  local -a excluded_dirs=(
    "/Volumes"
    "/System"
    "/dev"
    "/cores"
    "/bin"
    "/sbin"
    "/home"
    "/net"
  )

  # Build grep exclusion regex from the array above
  local joined exclude_regex
  joined=$(printf '%s|' "${excluded_dirs[@]}"); joined="${joined%|}"
  exclude_regex="^(${joined})(/|\$)"

  # Build fd search pattern: lowercase, spaces become .* (any separator, any length)
  local pattern
  pattern=$(printf '%s' "$app_name" | tr '[:upper:]' '[:lower:]' | sed 's/ /.*/g')

  echo -e "$WB ··> Searching for residuals of$CB $app_name$WB...$RESET"

  # Two fd passes: directories first (sorted shallow to deep), then files
  local -a dirs=() files=()

  while IFS= read -r line; do
    dirs+=("$line")
  done < <(
    sudo "$fd_bin" --hidden --ignore-case -t d "$pattern" / 2>/dev/null \
      | grep -vE "$exclude_regex" \
      | awk '{ s=$0; gsub(/[^\/]/,"",s); print length(s) "\t" $0 }' \
      | sort -n \
      | cut -f2-
  )

  while IFS= read -r line; do
    files+=("$line")
  done < <(
    sudo "$fd_bin" --hidden --ignore-case -t f "$pattern" / 2>/dev/null \
      | grep -vE "$exclude_regex"
  )

  local total=$(( ${#dirs[@]} + ${#files[@]} ))

  if [ "$total" -eq 0 ]; then
    echo -e "$WB ··> No residuals found for$CB $app_name$RESET\n"
    return 0
  fi

  echo -e "$WB ··> Found$CB $total$WB potential residuals ($CB${#dirs[@]}$WB directories,$CB ${#files[@]}$WB files)$RESET\n"

  local -a deleted_paths=()
  local deleted_dirs=0 deleted_files=0 skipped=0 failed=0
  local is_child answer

  for dir in "${dirs[@]}"; do
    [ -e "$dir" ] || { skipped=$(( skipped + 1 )); continue; }
    is_child=0
    for deleted in "${deleted_paths[@]}"; do
      [[ "$dir" == "$deleted"/* ]] && { is_child=1; break; }
    done
    [ "$is_child" -eq 1 ] && { skipped=$(( skipped + 1 )); continue; }

    echo -e "$WB ··>$MB [DIR]$WB  $MB$dir$RESET"
    echo -e "$WB ··> Delete it? [y/n]$RESET"
    printf "  > "
    read -r answer
    echo
    if [[ "$answer" == "y" ]]; then
      if sudo rm -rf "$dir"; then
        deleted_paths+=("$dir")
        deleted_dirs=$(( deleted_dirs + 1 ))
      else
        echo -e "$RB [ERROR] $WB Could not delete:$MB $dir$RESET"
        failed=$(( failed + 1 ))
      fi
    fi
  done

  for file in "${files[@]}"; do
    [ -e "$file" ] || { skipped=$(( skipped + 1 )); continue; }
    is_child=0
    for deleted in "${deleted_paths[@]}"; do
      [[ "$file" == "$deleted"/* ]] && { is_child=1; break; }
    done
    [ "$is_child" -eq 1 ] && { skipped=$(( skipped + 1 )); continue; }

    echo -e "$WB ··>$MB [FILE]$WB $MB$file$RESET"
    echo -e "$WB ··> Delete it? [y/n]$RESET"
    printf "  > "
    read -r answer
    echo
    if [[ "$answer" == "y" ]]; then
      if sudo rm "$file"; then
        deleted_paths+=("$file")
        deleted_files=$(( deleted_files + 1 ))
      else
        echo -e "$RB [ERROR] $WB Could not delete:$MB $file$RESET"
        failed=$(( failed + 1 ))
      fi
    fi
  done

  local total_deleted=$(( deleted_dirs + deleted_files ))
  shell-ok "$CB$total_deleted$WB deleted ($CB$deleted_dirs$WB directories,$CB $deleted_files$WB files).$CB $skipped$WB auto-skipped,$CB $failed$WB failed"
}
# D
dos2nix() {
  if [ $# -eq 0 ]; then
    shell-error "Usage: dos2nix <file>"
    return 1
  fi
  if [ ! -f "$1" ]; then
    shell-error "File not found: $1"
    return 1
  fi
  FILE=$(basename "$1")
  NAME="${FILE%.*}"
  tr -d '\r' < "$1" > "$NAME.nix.txt"
}
# E
# F
# G
gitbranch() {
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || \
  branch=$(git rev-parse --short HEAD 2>/dev/null) && \
  printf '{ %s } ' "$branch"
}
gitignore() {
  local API_URL="https://www.toptal.com/developers/gitignore/api"
  local PARAM="linux,macos,windows"
  local FILE=".gitignore"
  local answer name

  if [ $# -ne 0 ]; then
    for name in "$@"; do
      PARAM="$PARAM,$name"
    done
    echo -e "$WB ··> Creating$MB $FILE$WB with provided values:$CB $PARAM$RESET"
  else
    echo -e "$WB ··> Creating$MB $FILE$WB with default values:$CB $PARAM$RESET"
  fi

  if [ -f "$FILE" ]; then
    echo -e "$WB ··>$MB $FILE$WB already exists$RESET"
    printf "     [b] Create a backup and continue\n"
    printf "     [c] Cancel\n"
    printf "  > "
    read -r answer
    echo
    case "$answer" in
    "b")
      cp "$FILE" "$FILE.backup"
      echo -e "$WB ··> Backup created:$MB $FILE.backup$RESET\n"
      ;;
    *)
      shell-info "Cancelled"
      return 0
      ;;
    esac
  fi

  if ! curl --connect-timeout 10 -f -s -L "$API_URL/$PARAM" -o "$FILE"; then
    shell-error "Unable to fetch$MB $FILE$WB from the API"
    if [ -f "$FILE.backup" ]; then
      mv "$FILE.backup" "$FILE"
      echo -e "$WB ··> Original$MB $FILE$WB restored from backup$RESET\n"
    fi
    echo -e "$WB ··> You can check if your parameters are valid by performing:$RESET" >&2
    echo -e "$AB     curl --connect-timeout 10 -f -s -L \"$API_URL/list\" | grep -oE \"[^,]*PARAMETER[^,]*\"$RESET\n" >&2
    return 1
  fi

  if [ ! -f "$FILE" ] || [ ! -s "$FILE" ]; then
    shell-error "Downloaded$MB $FILE$WB is missing or empty — check your parameters"
    if [ -f "$FILE.backup" ]; then
      mv "$FILE.backup" "$FILE"
      echo -e "$WB ··> Original$MB $FILE$WB restored from backup$RESET\n"
    fi
    echo -e "$WB ··> You can check if your parameters are valid by performing:$RESET" >&2
    echo -e "$AB     curl --connect-timeout 10 -f -s -L \"$API_URL/list\" | grep -oE \"[^,]*PARAMETER[^,]*\"$RESET\n" >&2
    return 1
  fi

  shell-ok "$MB$FILE$WB created successfully"
}
# H
hosts() {
  HOSTS="/etc/hosts"
  if command -v bat > /dev/null 2>&1; then
    bat $HOSTS
  else
    cat $HOSTS
  fi
}
# I
# J
# K
kill-procs-on-volume() {
  local vol_path="$1"
  local user_name
  user_name="$(whoami)"

  if [[ -z "$vol_path" ]]; then
    shell-error "Usage: kill-procs-on-volume$MB /path/to/volume"
    return 1
  fi

  if [[ ! -d "$vol_path" ]]; then
    shell-error "Path not found:$MB $vol_path"
    return 1
  fi

  local vol_label
  vol_label="$(basename "$vol_path")"

  local -a proc_names
  local -a pids
  proc_names=()
  pids=()

  sudo -v || { shell-error "Authentication failed"; return 1; }

  while IFS=$'\t' read -r proc pid; do
    [[ -n "$proc" && "$pid" =~ ^[0-9]+$ ]] || continue
    proc_names+=("$proc")
    pids+=("$pid")
  done < <(
    sudo -n lsof "$vol_path" \
      | awk -v user="$user_name" 'NR>1 && $3==user {print $1 "\t" $2}' \
      | sort -u
  )

  echo -e "$WB ··> User:$CB $user_name$RESET"
  echo -e "$WB ··> Volume:$CB $vol_label$RESET"
  echo -e "$WB ··> Volume path:$MB $vol_path$RESET"

  if (( ${#pids[@]} == 0 )); then
    echo -e "$WB ··> Active processes:$CB none$RESET"
    echo
    return 0
  fi

  shell-info "Active processes:"
  for proc in "${proc_names[@]}"; do
    echo -e "  $WB -$RESET $proc"
  done
  echo

  echo -e "$WB ··>$CB $vol_label$WB has been analyzed. The following processes are still active.$RESET"
  echo -e "$WB ··> Terminate them gracefully? [y/n]$RESET"
  printf "  > "
  read -r answer

  if [[ "$answer" == "y" ]]; then
    local killed_any=0
    local pid
    for pid in "${pids[@]}"; do
      if kill "$pid" 2>/dev/null; then
        killed_any=1
      fi
    done

    if [[ "$killed_any" -eq 1 ]]; then
      echo -e "$WB ··>$CB SIGTERM$WB sent to the listed processes$RESET"
    else
      echo -e "$RB [ERROR] $WB No processes could be terminated (permission denied or already gone)$RESET"
    fi
    echo
  else
    shell-info "No processes were terminated"
    echo
  fi
}
# L
# M
# N
nix2dos() {
  if [ $# -eq 0 ]; then
    shell-error "Usage: nix2dos <file>"
    return 1
  fi
  if [ ! -f "$1" ]; then
    shell-error "File not found: $1"
    return 1
  fi
  FILE=$(basename "$1")
  NAME="${FILE%.*}"
  sed $'s/$/\r/' "$1" > "$NAME.dos.txt"
}
# O
# P
# Q
# R
reload-completions() {
    case "${INTERPRETER}" in
    "zsh")  rm -f "${ZDOTDIR:-$HOME}/.zcompdump"* ;;
    esac

    reload-shell
}
reload-shell() {
  local profile

  case "${INTERPRETER}" in
  "bash") profile="$HOME/.bash_profile" ;;
  "zsh")  profile="$HOME/.zsh_profile"  ;;
  esac

  if [ ! -r "$profile" ]; then
    shell-error "Profile not found or not readable: $profile"
    return 1
  fi

  clear

  # Path resolved at runtime from the interpreter in use
  # shellcheck disable=SC1090
  source "$profile"
}
repoinfo() {
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo -e "$WB ··> Name:$CB $(basename "$(pwd)")$RESET"
    echo -e "$WB ··> Branch:$CB $(gitbranch)$RESET"
    REGEX='^[0-9]+$'
    if [[ $# -eq 0 ]]; then
      shell-info "Last 7 commits:"
      git log -n 7 --oneline
    elif [[ $# -eq 1 ]] && [[ $1 =~ $REGEX ]] && [[ $1 -gt 0 ]]; then
      shell-info "Last $1 commits:"
      git log -n "$1" --oneline
    else
      shell-error "Remember to use only one positive integer as parameter"
      shell-info "Last 3 commits:"
      git log -n 3 --oneline
    fi
    shell-info "Stashed changes:"
    git stash list
    shell-info "Current changes:"
    git status -s
    echo
  else
    shell-error "There's no repository here"
  fi
}
# S
static-webserver() {
  SWS_DIR="./"
  if ! command -v python3 > /dev/null 2>&1; then
    shell-error "Python v3.X wasn't found in the OS"
    return 1
  fi
  if [ "$#" -gt 0 ] && [ ! -d "$1" ]; then
    shell-error "The parameter '$1' is not a directory, ignoring..."
  elif [ -d "$1" ]; then
    SWS_DIR="$1"
  fi
  echo "$WB Starting static web server at '$SWS_DIR'$RESET"
  python3 -m http.server --directory "$SWS_DIR" 80
}
# T
# U
update_terminal_cwd() {
  # Workaround to solve command not found in the editors integrated terminals
  # Identify the directory using a "file:" scheme URL,
  # including the host name to disambiguate local vs.
  # remote connections. Percent-escape spaces.
  local SEARCH=' '
  local REPLACE='%20'
  local PWD_URL="file://$HOSTNAME${PWD//$SEARCH/$REPLACE}"
  printf '\e]7;%s\a' "$PWD_URL"
}
# V
# W
worktree-ls() {
  if [ "$#" -ne 0 ]; then
    shell-error "Usage: worktree-ls"
    return 1
  fi

  local common_dir
  if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    shell-error "There's no repository here"
    return 1
  fi

  # --git-common-dir, not --show-toplevel: inside a worktree the latter would
  # return the worktree itself and the base would end up nested.
  common_dir="$(cd "$common_dir" && pwd)"
  local root repo base
  root="$(dirname "$common_dir")"
  repo="$(basename "$root")"
  base="$(dirname "$root")/$repo-worktrees"

  # A differing git dir is what tells a worktree apart from the main repository.
  local git_dir
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)"
  if [ -n "$git_dir" ] && [ "$git_dir" != "$common_dir" ]; then
    local here
    here="$(git rev-parse --show-toplevel 2>/dev/null)"
    # Only worktrees living under the conventional base get shortened; anything
    # else would be misreported as being there.
    case "$here" in
    "$base"/*) here="$repo-worktrees/${here##*/}" ;;
    esac
    shell-warn "Running from worktree$MB $here$WB, listing the whole repository"
  fi

  # Porcelain blocks are separated by a blank line. A prunable one is worth
  # flagging: its directory is gone, so it lists fine but cannot be entered.
  local entries
  entries="$(git worktree list --porcelain | awk '
    /^worktree /  { path = substr($0, 10); branch = "(detached)"; gone = "" ; next }
    /^branch /    { branch = substr($0, 8); sub("^refs/heads/", "", branch); next }
    /^prunable/   { gone = " (prunable)"; next }
    /^$/          { if (path != "") { print path "\t" branch gone; path = "" } }
    END           { if (path != "") { print path "\t" branch gone } }
  ')"

  # The first entry is always the main repository.
  local main_entry
  main_entry="$(printf '%s\n' "$entries" | head -n 1)"
  echo -e "$WB ··> Repository:$CB $repo$WB →$MB ${main_entry#*	}$RESET"

  shell-info "Worktrees:"
  printf '%s\n' "$entries" | tail -n +2 | while IFS="$(printf '\t')" read -r path branch; do
    case "$path" in
    "$base"/*) printf '     %s → %s\n' "${path##*/}" "$branch" ;;
    esac
  done | sort

  shell-info "External:"
  printf '%s\n' "$entries" | tail -n +2 | while IFS="$(printf '\t')" read -r path branch; do
    case "$path" in
    "$base"/*) ;;
    *) printf '     %s → %s\n' "$path" "$branch" ;;
    esac
  done | sort
}
worktree-mk() {
  if [ "$#" -ne 1 ]; then
    shell-error "Usage: worktree-mk <branch>"
    return 1
  fi

  local common_dir
  if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    shell-error "There's no repository here"
    return 1
  fi

  local branch="$1"
  # Checked before anything else so the reason is always the same one, no
  # matter where HEAD happens to be.
  case "$branch" in
  master | master/* | main | main/* | develop | develop/* | release | release/*)
    shell-error "Refusing to create a worktree for the base branch$CB $branch"
    return 1
    ;;
  esac

  # --git-common-dir, not --show-toplevel: inside a worktree the latter would
  # return the worktree itself and the base would end up nested.
  common_dir="$(cd "$common_dir" && pwd)"
  local root repo base
  root="$(dirname "$common_dir")"
  repo="$(basename "$root")"
  base="$(dirname "$root")/$repo-worktrees"
  # Slashes would nest one directory per path segment.
  local dest="$base/wt-${branch//\//-}"
  local short="$repo-worktrees/wt-${branch//\//-}"

  # Absolute so the command works from any window; a literal $HOME keeps it
  # short and still expands when pasted.
  local hint="$dest"
  case "$dest" in
  "$HOME"/*) hint="\$HOME${dest#"$HOME"}" ;;
  esac

  # Already there: this is the "pick it up tomorrow" path. No cd either, so the
  # function never moves the current window, whether it creates or re-enters.
  if [ -e "$dest" ]; then
    if git -C "$dest" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      # Read from the worktree instead of echoing the argument: sanitising / to
      # - makes two different branches land on the same directory.
      local existing
      existing="$(git -C "$dest" symbolic-ref --short HEAD 2>/dev/null)" || existing="(detached)"
      echo -e "$WB ··> Worktree already exists:$MB $short$RESET"
      echo -e "$WB ··> Branch:$CB $existing$RESET"
      echo -e "$WB ··> Enter it with:$AB cd \"$hint\"$RESET"
      return 0
    fi
    shell-error "$MB$short$WB exists but it's not a valid worktree"
    return 1
  fi

  # Asking git instead of parsing its stderr, which is translated.
  local checked_out
  checked_out="$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
    /^worktree /  { path = substr($0, 10) }
    /^branch /    { if (substr($0, 8) == b) { print path; exit } }
  ')"
  if [ -n "$checked_out" ]; then
    # Only worktrees living under the conventional base get shortened; anything
    # else would be misreported as being there.
    local where="$checked_out"
    case "$checked_out" in
    "$root") where="$repo" ;;
    "$base"/*) where="$repo-worktrees/${checked_out##*/}" ;;
    esac
    shell-error "Branch$CB $branch$WB is already checked out at$MB $where"
    return 1
  fi

  local reuse=0
  git show-ref --verify --quiet "refs/heads/$branch" && reuse=1

  # Reusing keeps the branch as it is; creating derives from wherever HEAD is,
  # so the branch to validate differs.
  local target="$branch"
  if [ "$reuse" -eq 0 ]; then
    if ! target="$(git symbolic-ref --short HEAD 2>/dev/null)"; then
      shell-error "HEAD is detached, switch to a branch first"
      return 1
    fi
  fi

  if ! git fetch --quiet 2>/dev/null; then
    shell-warn "Could not fetch from remote, comparing against local refs"
  fi

  local upstream
  if ! upstream="$(git rev-parse --abbrev-ref "$target@{u}" 2>/dev/null)"; then
    shell-warn "$CB$target$WB has no upstream branch"
  else
    local counts behind ahead
    counts="$(git rev-list --left-right --count "$upstream...$target" 2>/dev/null)"
    behind="${counts%%[[:space:]]*}"
    ahead="${counts##*[[:space:]]}"
    if [ "${behind:-0}" -gt 0 ]; then
      local plural=""
      [ "$behind" -ne 1 ] && plural="s"
      shell-error "$CB$target$WB is$CB $behind$WB commit$plural behind$CB $upstream$WB, pull before continuing"
      return 1
    fi
    if [ "${ahead:-0}" -gt 0 ]; then
      local plural=""
      [ "$ahead" -ne 1 ] && plural="s"
      shell-warn "$CB$target$WB is$CB $ahead$WB commit$plural ahead of$CB $upstream"
    fi
  fi

  if [ "$reuse" -eq 1 ]; then
    git worktree add --quiet "$dest" "$branch" || return 1
    echo -e "$WB ··> Worktree:$MB $short$RESET"
    echo -e "$WB ··> Branch:$CB $branch$RESET"
  else
    git worktree add --quiet "$dest" -b "$branch" || return 1
    echo -e "$WB ··> Worktree:$MB $short$RESET"
    echo -e "$WB ··> Branch:$CB $branch$WB (new, from$CB $target$WB)$RESET"
  fi

  echo -e "$WB ··> Enter it with:$AB cd \"$hint\"$RESET"
}
worktree-rm() {
  if [ "$#" -ne 1 ]; then
    shell-error "Usage: worktree-rm <branch>"
    return 1
  fi

  local common_dir
  if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    shell-error "There's no repository here"
    return 1
  fi

  # --git-common-dir, not --show-toplevel: inside a worktree the latter would
  # return the worktree itself and the base would end up nested.
  common_dir="$(cd "$common_dir" && pwd)"
  local root repo base
  root="$(dirname "$common_dir")"
  repo="$(basename "$root")"
  base="$(dirname "$root")/$repo-worktrees"

  # Removing is destructive, so it is only allowed from the main repository:
  # a differing git dir is what tells a worktree apart from it.
  local git_dir
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)"
  if [ -n "$git_dir" ] && [ "$git_dir" != "$common_dir" ]; then
    local here
    here="$(git rev-parse --show-toplevel 2>/dev/null)"
    # Only worktrees living under the conventional base get shortened; anything
    # else would be misreported as being there.
    case "$here" in
    "$base"/*) here="$repo-worktrees/${here##*/}" ;;
    esac
    shell-error "Run this from$CB $repo$WB, not from the worktree$MB $here"
    return 1
  fi

  local branch="$1"
  # Slashes would nest one directory per path segment.
  local dest="$base/wt-${branch//\//-}"
  local short="$repo-worktrees/wt-${branch//\//-}"

  if [ ! -e "$dest" ]; then
    shell-error "There's no worktree for branch$CB $branch"
    return 1
  fi
  if ! git -C "$dest" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    shell-error "$MB$short$WB exists but it's not a valid worktree"
    return 1
  fi

  # Uncommitted work is never worth losing, so this one is not negotiable.
  # The stash is deliberately not checked: it is global to the repository and
  # cannot be reliably attributed to a single worktree.
  if [ -n "$(git -C "$dest" status --porcelain 2>/dev/null)" ]; then
    shell-error "Worktree$MB $short$WB has uncommitted changes, commit or discard them first"
    return 1
  fi

  if ! git fetch --quiet 2>/dev/null; then
    shell-warn "Could not fetch from remote, comparing against local refs"
  fi

  # Anything not pushed is lost with the branch, hence the asymmetry: ahead
  # aborts, behind only warns because the local commits are already upstream.
  local answer upstream
  if ! upstream="$(git -C "$dest" rev-parse --abbrev-ref "$branch@{u}" 2>/dev/null)"; then
    echo -e "$WB ··>$CB $branch$WB has no upstream branch, its commits only exist here.$RESET"
    echo -e "$WB ··> Remove it anyway? [y/n]$RESET"
    printf "  > "
    read -r answer
    echo
    [[ "$answer" == "y" ]] || return 1
  else
    local counts behind ahead plural
    counts="$(git -C "$dest" rev-list --left-right --count "$upstream...$branch" 2>/dev/null)"
    behind="${counts%%[[:space:]]*}"
    ahead="${counts##*[[:space:]]}"
    if [ "${ahead:-0}" -gt 0 ]; then
      plural=""
      [ "$ahead" -ne 1 ] && plural="s"
      shell-error "$CB$branch$WB is$CB $ahead$WB commit$plural ahead of$CB $upstream$WB, push before removing"
      return 1
    fi
    if [ "${behind:-0}" -gt 0 ]; then
      plural=""
      [ "$behind" -ne 1 ] && plural="s"
      echo -e "$WB ··>$CB $branch$WB is$CB $behind$WB commit$plural behind$CB $upstream$RESET"
      echo -e "$WB ··> Remove it anyway? [y/n]$RESET"
      printf "  > "
      read -r answer
      echo
      [[ "$answer" == "y" ]] || return 1
    fi
  fi

  git worktree remove "$dest" || return 1
  git worktree prune
  shell-ok "Removed worktree:$MB $short"

  # The branch outlives the worktree, so removing it is a separate decision.
  echo -e "$WB ··> Delete the local branch$CB $branch$WB too? [y/n]$RESET"
  printf "  > "
  read -r answer
  echo
  if [[ "$answer" == "y" ]]; then
    git branch -D "$branch" || return 1
  fi
}
