# shellcheck shell=bash
# === === === SHELL FUNCTIONS === === === #
# A
add-space-to-dock() {
  if ! defaults write com.apple.dock persistent-apps -array-add '{"tile-type"="spacer-tile";}'; then
    echo -e "\n$RB [ERROR] Could not write to Dock preferences$RESET\n"
    return 1
  fi
  killall Dock
  sleep 3
  open -a Dock
}
# B
# C
cleanup-history() {
  case "${INTERPRETER}" in
  "bash")
    echo -n > "$HOME/.bash_history"
    history -c
    ;;
  "zsh")
    echo -n > "$HOME/.zsh_history"
    ;;
  esac
}
cleanup-app-associated-files() {
  if [ $# -eq 0 ]; then
    echo -e "\n$RB [ERROR] Usage: cleanup-app-associated-files <app_name>$RESET\n"
    return 1
  fi

  local app_name="$*"
  local fd_bin
  fd_bin="$(command -v fd)" || {
    echo -e "\n$RB [ERROR] fd not found$RESET\n"
    return 1
  }

  echo -e "\n$WB ··> Elevated permissions are required to search and delete protected directories.$RESET"
  sudo -v || { echo -e "\n$RB [ERROR] Authentication failed$RESET\n"; return 1; }

  # Directories excluded from the search — add or remove entries as needed
  local -a excluded_dirs=(
    "/Volumes"
    "/System"
    "/dev"
    "/cores"
    "/bin"
    "/sbin"
    "/home"
    "/net"
  )

  # Build grep exclusion regex from the array above
  local joined exclude_regex
  joined=$(printf '%s|' "${excluded_dirs[@]}"); joined="${joined%|}"
  exclude_regex="^(${joined})(/|\$)"

  # Build fd search pattern: lowercase, spaces become .* (any separator, any length)
  local pattern
  pattern=$(printf '%s' "$app_name" | tr '[:upper:]' '[:lower:]' | sed 's/ /.*/g')

  echo -e "$WB ··> Searching for residuals of '$YB$app_name$WB'...$RESET"

  # Two fd passes: directories first (sorted shallow to deep), then files
  local -a dirs=() files=()

  while IFS= read -r line; do
    dirs+=("$line")
  done < <(
    sudo "$fd_bin" --hidden --ignore-case -t d "$pattern" / 2>/dev/null \
      | grep -vE "$exclude_regex" \
      | awk '{ s=$0; gsub(/[^\/]/,"",s); print length(s) "\t" $0 }' \
      | sort -n \
      | cut -f2-
  )

  while IFS= read -r line; do
    files+=("$line")
  done < <(
    sudo "$fd_bin" --hidden --ignore-case -t f "$pattern" / 2>/dev/null \
      | grep -vE "$exclude_regex"
  )

  local total=$(( ${#dirs[@]} + ${#files[@]} ))

  if [ "$total" -eq 0 ]; then
    echo -e "$WB ··> No residuals found for '$YB$app_name$WB'$RESET\n"
    return 0
  fi

  echo -e "$WB ··> Found$YB $total$WB potential residuals ($YB${#dirs[@]}$WB directories,$YB ${#files[@]}$WB files)$RESET\n"

  local -a deleted_paths=()
  local deleted_dirs=0 deleted_files=0 skipped=0 failed=0
  local is_child answer

  for dir in "${dirs[@]}"; do
    [ -e "$dir" ] || { skipped=$(( skipped + 1 )); continue; }
    is_child=0
    for deleted in "${deleted_paths[@]}"; do
      [[ "$dir" == "$deleted"/* ]] && { is_child=1; break; }
    done
    [ "$is_child" -eq 1 ] && { skipped=$(( skipped + 1 )); continue; }

    echo -e "$WB ··>$YB [DIR]$WB  $dir$RESET"
    printf "  Delete? [y/n]: "
    read -r answer
    echo
    if [[ "$answer" == "y" ]]; then
      if sudo rm -rf "$dir"; then
        deleted_paths+=("$dir")
        deleted_dirs=$(( deleted_dirs + 1 ))
      else
        echo -e "$RB [ERROR] Could not delete: $dir$RESET"
        failed=$(( failed + 1 ))
      fi
    fi
  done

  for file in "${files[@]}"; do
    [ -e "$file" ] || { skipped=$(( skipped + 1 )); continue; }
    is_child=0
    for deleted in "${deleted_paths[@]}"; do
      [[ "$file" == "$deleted"/* ]] && { is_child=1; break; }
    done
    [ "$is_child" -eq 1 ] && { skipped=$(( skipped + 1 )); continue; }

    echo -e "$WB ··>$YB [FILE]$WB $file$RESET"
    printf "  Delete? [y/n]: "
    read -r answer
    echo
    if [[ "$answer" == "y" ]]; then
      if sudo rm "$file"; then
        deleted_paths+=("$file")
        deleted_files=$(( deleted_files + 1 ))
      else
        echo -e "$RB [ERROR] Could not delete: $file$RESET"
        failed=$(( failed + 1 ))
      fi
    fi
  done

  local total_deleted=$(( deleted_dirs + deleted_files ))
  echo -e "$WB ··> Done.$YB $total_deleted$WB deleted ($YB$deleted_dirs$WB directories,$YB $deleted_files$WB files).$YB $skipped$WB auto-skipped$YB $failed$WB failed$RESET\n"
}
# D
dos2nix() {
  if [ $# -eq 0 ]; then
    echo -e "\n$RB [ERROR] Usage: dos2nix <file>$RESET\n"
    return 1
  fi
  if [ ! -f "$1" ]; then
    echo -e "\n$RB [ERROR] File not found: $1$RESET\n"
    return 1
  fi
  FILE=$(basename "$1")
  NAME="${FILE%.*}"
  tr -d '\r' < "$1" > "$NAME.nix.txt"
}
# E
# F
# G
gitbranch() {
  local branch
  branch=$(git symbolic-ref --short HEAD 2>/dev/null) || \
  branch=$(git rev-parse --short HEAD 2>/dev/null) && \
  printf '{ %s } ' "$branch"
}
gitignore() {
  local API_URL="https://www.toptal.com/developers/gitignore/api"
  local PARAM="linux,macos,windows"
  local FILE=".gitignore"
  local answer name

  if [ $# -ne 0 ]; then
    for name in "$@"; do
      PARAM="$PARAM,$name"
    done
    echo -e "$WB Creating '$RB$FILE$WB' with provided values:$YB $PARAM $RESET"
  else
    echo -e "$WB Creating '$RB$FILE$WB' with default values:$YB $PARAM $RESET"
  fi

  if [ -f "$FILE" ]; then
    echo -e "$WB ··>$YB $FILE$WB already exists.$RESET"
    printf "  [b] Create a backup and continue\n"
    printf "  [c] Cancel\n"
    printf "  > "
    read -r answer
    echo
    case "$answer" in
    "b")
      cp "$FILE" "$FILE.backup"
      echo -e "$WB ··> Backup created:$YB $FILE.backup$RESET\n"
      ;;
    *)
      echo -e "$WB ··> Cancelled$RESET\n"
      return 0
      ;;
    esac
  fi

  if ! curl --connect-timeout 10 -f -s -L "$API_URL/$PARAM" -o "$FILE"; then
    echo -e "\n$RB [ERROR] Unable to fetch '$FILE' from the API$RESET\n"
    if [ -f "$FILE.backup" ]; then
      mv "$FILE.backup" "$FILE"
      echo -e "$WB ··> Original '$FILE' restored from backup$RESET\n"
    fi
    echo -e "$WB You can check if your parameters are valid by performing:"
    echo -e "\t>>$YB curl --connect-timeout 10 -f -s -L \"$API_URL/list\" | grep -oE \"[^,]*PARAMETER[^,]*\"$WB <<$RESET\n"
    return 1
  fi

  if [ ! -f "$FILE" ] || [ ! -s "$FILE" ]; then
    echo -e "\n$RB [ERROR] Downloaded '$FILE' is missing or empty — check your parameters$RESET\n"
    if [ -f "$FILE.backup" ]; then
      mv "$FILE.backup" "$FILE"
      echo -e "$WB ··> Original '$FILE' restored from backup$RESET\n"
    fi
    echo -e "$WB You can check if your parameters are valid by performing:"
    echo -e "\t>>$YB curl --connect-timeout 10 -f -s -L \"$API_URL/list\" | grep -oE \"[^,]*PARAMETER[^,]*\"$WB <<$RESET\n"
    return 1
  fi

  echo -e "$WB ··>$YB $FILE$WB created successfully$RESET\n"
}
# H
hosts() {
  HOSTS="/etc/hosts"
  if command -v bat > /dev/null 2>&1; then
    bat $HOSTS
  else
    cat $HOSTS
  fi
}
# I
# J
# K
kill-procs-on-volume() {
  local vol_path="$1"
  local user_name
  user_name="$(whoami)"

  if [[ -z "$vol_path" ]]; then
    echo -e "\n$RB [ERROR] Usage:$MB kill_procs_on_volume /path/to/volume$RESET\n"
    return 1
  fi

  if [[ ! -d "$vol_path" ]]; then
    echo -e "\n$RB [ERROR] Path not found:$MB \"$vol_path\"$RESET\n"
    return 1
  fi

  local vol_label
  vol_label="$(basename "$vol_path")"

  local -a proc_names
  local -a pids
  proc_names=()
  pids=()

  sudo -v || { echo -e "\n$RB [ERROR] Authentication failed$RESET\n"; return 1; }

  while IFS=$'\t' read -r proc pid; do
    [[ -n "$proc" && "$pid" =~ ^[0-9]+$ ]] || continue
    proc_names+=("$proc")
    pids+=("$pid")
  done < <(
    sudo -n lsof "$vol_path" \
      | awk -v user="$user_name" 'NR>1 && $3==user {print $1 "\t" $2}' \
      | sort -u
  )

  echo -e "$WB ··> User:$YB $user_name$RESET"
  echo -e "$WB ··> Volume:$YB $vol_label$RESET"
  echo -e "$WB ··> Volume path:$YB $vol_path$RESET"

  if (( ${#pids[@]} == 0 )); then
    echo -e "$WB ··> Active processes:$RB none$RESET"
    echo
    return 0
  fi

  echo -e "$WB ··> Active processes:$RESET"
  for proc in "${proc_names[@]}"; do
    echo -e "  $WB -$RESET $proc"
  done
  echo

  echo -e "$WB ··>$YB $vol_label$WB has been analyzed. The following processes are still active. Do you want to terminate them gracefully? [y/n]$RESET"
  printf "  > "
  read -r answer

  if [[ "$answer" == "y" ]]; then
    local killed_any=0
    local pid
    for pid in "${pids[@]}"; do
      if kill "$pid" 2>/dev/null; then
        killed_any=1
      fi
    done

    if [[ "$killed_any" -eq 1 ]]; then
      echo -e "$WB ··>$MB SIGTERM$WB sent to the listed processes.$RESET"
    else
      echo -e "$RB [ERROR] No processes could be terminated (permission denied or already gone).$RESET"
    fi
    echo
  else
    echo -e "$WB ··> No processes were terminated.$RESET"
    echo
  fi
}
# L
# M
# N
nix2dos() {
  if [ $# -eq 0 ]; then
    echo -e "\n$RB [ERROR] Usage: nix2dos <file>$RESET\n"
    return 1
  fi
  if [ ! -f "$1" ]; then
    echo -e "\n$RB [ERROR] File not found: $1$RESET\n"
    return 1
  fi
  FILE=$(basename "$1")
  NAME="${FILE%.*}"
  sed $'s/$/\r/' "$1" > "$NAME.dos.txt"
}
# O
# P
# Q
# R
reload-completions() {
    case "${INTERPRETER}" in
    "zsh")  rm -f "${ZDOTDIR:-$HOME}/.zcompdump"* ;;
    esac

    reload-shell
}
reload-shell() {
  local profile

  case "${INTERPRETER}" in
  # shellcheck source=../bash/profile.bash
  "bash") profile="$HOME/.bash_profile" ;;
  # shellcheck source=../zsh/profile.zsh
  "zsh")  profile="$HOME/.zsh_profile"  ;;
  esac

  if [ ! -r "$profile" ]; then
    echo -e "\n$RB [ERROR] Profile not found or not readable: $profile$RESET\n"
    return 1
  fi

  clear

  source "$profile"
}
repoinfo() {
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo -e "$WB ··> Name:$YB $(basename "$(pwd)")$RESET"
    echo -e "$WB ··> Branch:$YB $(gitbranch)$RESET"
    REGEX='^[0-9]+$'
    if [[ $# -eq 0 ]]; then
      echo -e "$WB ··> Last 7 commits:$RESET"
      git log -n 7 --oneline
    elif [[ $# -eq 1 ]] && [[ $1 =~ $REGEX ]] && [[ $1 -gt 0 ]]; then
      echo -e "$WB ··> Last $1 commits:$RESET"
      git log -n "$1" --oneline
    else
      echo -e "\n$RB [ERROR] Remember to use only one positive integer as parameter$RESET\n"
      echo -e "$WB ··> Last 3 commits:$RESET"
      git log -n 3 --oneline
    fi
    echo -e "$WB ··> Stashed changes:$RESET"
    git stash list
    echo -e "$WB ··> Current changes:$RESET"
    git status -s
    echo
  else
    echo -e "\n$RB [ERROR] There's no repository here$RESET\n"
  fi
}
# S
static-webserver() {
  SWS_DIR="./"
  if ! command -v python3 > /dev/null 2>&1; then
    echo -e "\n$RB [ERROR] Python v3.X wasn't found in the OS$RESET\n"
    return 1
  fi
  if [ "$#" -gt 0 ] && [ ! -d "$1" ]; then
    echo -e "\n$RB [ERROR] The parameter '$1' is not a directory, ignoring...$RESET\n"
  elif [ -d "$1" ]; then
    SWS_DIR="$1"
  fi
  echo "$WB Starting static web server at '$SWS_DIR'$RESET"
  python3 -m http.server --directory "$SWS_DIR" 80
}
# T
# U
update_terminal_cwd() {
  # Workaround to solve command not found in the editors integrated terminals
  # Identify the directory using a "file:" scheme URL,
  # including the host name to disambiguate local vs.
  # remote connections. Percent-escape spaces.
  local SEARCH=' '
  local REPLACE='%20'
  local PWD_URL="file://$HOSTNAME${PWD//$SEARCH/$REPLACE}"
  printf '\e]7;%s\a' "$PWD_URL"
}
# V
# W
worktree-ls() {
  if [ "$#" -ne 0 ]; then
    echo -e "\n$RB [ERROR] Usage: worktree-ls$RESET\n"
    return 1
  fi

  local common_dir
  if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    echo -e "\n$RB [ERROR] There's no repository here$RESET\n"
    return 1
  fi

  # --git-common-dir, not --show-toplevel: inside a worktree the latter would
  # return the worktree itself and the base would end up nested.
  common_dir="$(cd "$common_dir" && pwd)"
  local root repo base
  root="$(dirname "$common_dir")"
  repo="$(basename "$root")"
  base="$(dirname "$root")/$repo-worktrees"

  # A differing git dir is what tells a worktree apart from the main repository.
  local git_dir
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)"
  if [ -n "$git_dir" ] && [ "$git_dir" != "$common_dir" ]; then
    local here
    here="$(git rev-parse --show-toplevel 2>/dev/null)"
    # Only worktrees living under the conventional base get shortened; anything
    # else would be misreported as being there.
    case "$here" in
    "$base"/*) here="$repo-worktrees/${here##*/}" ;;
    esac
    echo -e "$YB [WARN] Running from worktree '$here', listing the whole repository$RESET"
  fi

  # Porcelain blocks are separated by a blank line. A prunable one is worth
  # flagging: its directory is gone, so it lists fine but cannot be entered.
  local entries
  entries="$(git worktree list --porcelain | awk '
    /^worktree /  { path = substr($0, 10); branch = "(detached)"; gone = "" ; next }
    /^branch /    { branch = substr($0, 8); sub("^refs/heads/", "", branch); next }
    /^prunable/   { gone = " (prunable)"; next }
    /^$/          { if (path != "") { print path "\t" branch gone; path = "" } }
    END           { if (path != "") { print path "\t" branch gone } }
  ')"

  # The first entry is always the main repository.
  local main_entry
  main_entry="$(printf '%s\n' "$entries" | head -n 1)"
  echo -e "$WB ··> Repository:$YB $repo$WB →$YB ${main_entry#*	}$RESET"

  echo -e "$WB ··> Worktrees:$RESET"
  printf '%s\n' "$entries" | tail -n +2 | while IFS="$(printf '\t')" read -r path branch; do
    case "$path" in
    "$base"/*) printf '     %s → %s\n' "${path##*/}" "$branch" ;;
    esac
  done | sort

  echo -e "$WB ··> External:$RESET"
  printf '%s\n' "$entries" | tail -n +2 | while IFS="$(printf '\t')" read -r path branch; do
    case "$path" in
    "$base"/*) ;;
    *) printf '     %s → %s\n' "$path" "$branch" ;;
    esac
  done | sort
}
worktree-mk() {
  if [ "$#" -ne 1 ]; then
    echo -e "\n$RB [ERROR] Usage: worktree-mk <branch>$RESET\n"
    return 1
  fi

  local common_dir
  if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    echo -e "\n$RB [ERROR] There's no repository here$RESET\n"
    return 1
  fi

  local branch="$1"
  # Checked before anything else so the reason is always the same one, no
  # matter where HEAD happens to be.
  case "$branch" in
  master | master/* | main | main/* | develop | develop/* | release | release/*)
    echo -e "\n$RB [ERROR] Refusing to create a worktree for the base branch '$branch'$RESET\n"
    return 1
    ;;
  esac

  # --git-common-dir, not --show-toplevel: inside a worktree the latter would
  # return the worktree itself and the base would end up nested.
  common_dir="$(cd "$common_dir" && pwd)"
  local root repo base
  root="$(dirname "$common_dir")"
  repo="$(basename "$root")"
  base="$(dirname "$root")/$repo-worktrees"
  # Slashes would nest one directory per path segment.
  local dest="$base/wt-${branch//\//-}"
  local short="$repo-worktrees/wt-${branch//\//-}"

  # Already there: this is the "pick it up tomorrow" path.
  if [ -e "$dest" ]; then
    if git -C "$dest" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo -e "$WB ··> Entering worktree:$YB $short$RESET"
      cd "$dest" || return 1
      return 0
    fi
    echo -e "\n$RB [ERROR] '$short' exists but it's not a valid worktree$RESET\n"
    return 1
  fi

  # Asking git instead of parsing its stderr, which is translated.
  local checked_out
  checked_out="$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
    /^worktree /  { path = substr($0, 10) }
    /^branch /    { if (substr($0, 8) == b) { print path; exit } }
  ')"
  if [ -n "$checked_out" ]; then
    # Only worktrees living under the conventional base get shortened; anything
    # else would be misreported as being there.
    local where="$checked_out"
    case "$checked_out" in
    "$root") where="$repo" ;;
    "$base"/*) where="$repo-worktrees/${checked_out##*/}" ;;
    esac
    echo -e "\n$RB [ERROR] Branch '$branch' is already checked out at '$where'$RESET\n"
    return 1
  fi

  local reuse=0
  git show-ref --verify --quiet "refs/heads/$branch" && reuse=1

  # Reusing keeps the branch as it is; creating derives from wherever HEAD is,
  # so the branch to validate differs.
  local target="$branch"
  if [ "$reuse" -eq 0 ]; then
    if ! target="$(git symbolic-ref --short HEAD 2>/dev/null)"; then
      echo -e "\n$RB [ERROR] HEAD is detached, switch to a branch first$RESET\n"
      return 1
    fi
  fi

  if ! git fetch --quiet 2>/dev/null; then
    echo -e "$YB [WARN] Could not fetch from remote, comparing against local refs$RESET"
  fi

  local upstream
  if ! upstream="$(git rev-parse --abbrev-ref "$target@{u}" 2>/dev/null)"; then
    echo -e "$YB [WARN] '$target' has no upstream branch$RESET"
  else
    local counts behind ahead
    counts="$(git rev-list --left-right --count "$upstream...$target" 2>/dev/null)"
    behind="${counts%%[[:space:]]*}"
    ahead="${counts##*[[:space:]]}"
    if [ "${behind:-0}" -gt 0 ]; then
      local plural=""
      [ "$behind" -ne 1 ] && plural="s"
      echo -e "\n$RB [ERROR] '$target' is $behind commit$plural behind '$upstream', pull before continuing$RESET\n"
      return 1
    fi
    if [ "${ahead:-0}" -gt 0 ]; then
      local plural=""
      [ "$ahead" -ne 1 ] && plural="s"
      echo -e "$YB [WARN] '$target' is $ahead commit$plural ahead of '$upstream'$RESET"
    fi
  fi

  if [ "$reuse" -eq 1 ]; then
    git worktree add --quiet "$dest" "$branch" || return 1
    echo -e "$WB ··> Worktree:$YB $short$RESET"
    echo -e "$WB ··> Branch:$YB $branch$RESET"
  else
    git worktree add --quiet "$dest" -b "$branch" || return 1
    echo -e "$WB ··> Worktree:$YB $short$RESET"
    echo -e "$WB ··> Branch:$YB $branch$WB (new, from$YB $target$WB)$RESET"
  fi

  cd "$dest" || return 1
}
worktree-rm() {
  if [ "$#" -ne 1 ]; then
    echo -e "\n$RB [ERROR] Usage: worktree-rm <branch>$RESET\n"
    return 1
  fi

  local common_dir
  if ! common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
    echo -e "\n$RB [ERROR] There's no repository here$RESET\n"
    return 1
  fi

  # --git-common-dir, not --show-toplevel: inside a worktree the latter would
  # return the worktree itself and the base would end up nested.
  common_dir="$(cd "$common_dir" && pwd)"
  local root repo base
  root="$(dirname "$common_dir")"
  repo="$(basename "$root")"
  base="$(dirname "$root")/$repo-worktrees"

  # Removing is destructive, so it is only allowed from the main repository:
  # a differing git dir is what tells a worktree apart from it.
  local git_dir
  git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null)"
  if [ -n "$git_dir" ] && [ "$git_dir" != "$common_dir" ]; then
    local here
    here="$(git rev-parse --show-toplevel 2>/dev/null)"
    # Only worktrees living under the conventional base get shortened; anything
    # else would be misreported as being there.
    case "$here" in
    "$base"/*) here="$repo-worktrees/${here##*/}" ;;
    esac
    echo -e "\n$RB [ERROR] Run this from '$repo', not from the worktree '$here'$RESET\n"
    return 1
  fi

  local branch="$1"
  # Slashes would nest one directory per path segment.
  local dest="$base/wt-${branch//\//-}"
  local short="$repo-worktrees/wt-${branch//\//-}"

  if [ ! -e "$dest" ]; then
    echo -e "\n$RB [ERROR] There's no worktree for branch '$branch'$RESET\n"
    return 1
  fi
  if ! git -C "$dest" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo -e "\n$RB [ERROR] '$short' exists but it's not a valid worktree$RESET\n"
    return 1
  fi

  # Uncommitted work is never worth losing, so this one is not negotiable.
  # The stash is deliberately not checked: it is global to the repository and
  # cannot be reliably attributed to a single worktree.
  if [ -n "$(git -C "$dest" status --porcelain 2>/dev/null)" ]; then
    echo -e "\n$RB [ERROR] Worktree '$short' has uncommitted changes, commit or discard them first$RESET\n"
    return 1
  fi

  if ! git fetch --quiet 2>/dev/null; then
    echo -e "$YB [WARN] Could not fetch from remote, comparing against local refs$RESET"
  fi

  # Anything not pushed is lost with the branch, hence the asymmetry: ahead
  # aborts, behind only warns because the local commits are already upstream.
  local answer upstream
  if ! upstream="$(git -C "$dest" rev-parse --abbrev-ref "$branch@{u}" 2>/dev/null)"; then
    echo -e "$WB ··>$YB '$branch'$WB has no upstream branch, its commits only exist here. Remove it anyway? [y/n]$RESET"
    printf "  > "
    read -r answer
    echo
    [[ "$answer" == "y" ]] || return 1
  else
    local counts behind ahead plural
    counts="$(git -C "$dest" rev-list --left-right --count "$upstream...$branch" 2>/dev/null)"
    behind="${counts%%[[:space:]]*}"
    ahead="${counts##*[[:space:]]}"
    if [ "${ahead:-0}" -gt 0 ]; then
      plural=""
      [ "$ahead" -ne 1 ] && plural="s"
      echo -e "\n$RB [ERROR] '$branch' is $ahead commit$plural ahead of '$upstream', push before removing$RESET\n"
      return 1
    fi
    if [ "${behind:-0}" -gt 0 ]; then
      plural=""
      [ "$behind" -ne 1 ] && plural="s"
      echo -e "$WB ··>$YB '$branch'$WB is $behind commit$plural behind$YB '$upstream'$WB. Remove it anyway? [y/n]$RESET"
      printf "  > "
      read -r answer
      echo
      [[ "$answer" == "y" ]] || return 1
    fi
  fi

  git worktree remove "$dest" || return 1
  git worktree prune
  echo -e "$WB ··> Removed worktree:$YB $short$RESET"

  # The branch outlives the worktree, so removing it is a separate decision.
  echo -e "$WB ··> Delete the local branch$YB $branch$WB too? [y/n]$RESET"
  printf "  > "
  read -r answer
  echo
  if [[ "$answer" == "y" ]]; then
    git branch -D "$branch" || return 1
  fi
}
# X
# Y
# Z
